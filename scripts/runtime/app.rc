// Icon and version info compiled into the Windows runtime (see build-runtime.ps1).
#pragma code_page(65001)

1 ICON "../../assets/icon.ico"

1 VERSIONINFO
FILEVERSION       1, 0, 0, 0
PRODUCTVERSION    1, 0, 0, 0
FILEFLAGSMASK     0
FILEOS            0x00040004L    // VOS_NT_WINDOWS32
FILETYPE          1              // VFT_APP
{
	BLOCK "StringFileInfo"
	{
		BLOCK "040904b0"
		{
			VALUE "FileDescription",  "KanbanEasy"
			VALUE "ProductName",      "KanbanEasy"
			VALUE "FileVersion",      "1.0"
			VALUE "ProductVersion",   "1.0"
			VALUE "LegalCopyright",   "KanbanEasy (MIT). Runs on LÖVE 11.5, © 2006-2023 LÖVE Development Team"
			VALUE "OriginalFilename", "KanbanEasy.exe"
		}
	}

	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x409, 1200
	}
}
