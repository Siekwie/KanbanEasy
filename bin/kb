#!/usr/bin/env bash
# kb: tiny command line client for the KanbanEasy local API.
#
#   kb                         show the board (markdown)
#   kb ls [status]             list issues, optionally in one status
#   kb show KE-12              one issue with comments
#   kb add "Title" [k=v ...]   create (e.g. status=todo priority=high labels=bug,api assignee=me)
#   kb mv KE-12 review [pos]   move to a status (optional 1-based position)
#   kb set KE-12 k=v [k=v ...] update fields (title, description, status, priority, labels, assignee)
#   kb note KE-12 "text"       add a comment
#   kb claim [name]            take the next todo, assign it and move it to in_progress
#   kb mine [name]             open issues assigned to you (or name; "agent" and "me" work)
#   kb people [me=x agent=y default=me]   show or set who "me" and "agent" are
#   kb rule COLUMN [assign=agent] [instructions="..."]
#                              cards landing in COLUMN get that assignee (me, agent, a name,
#                              - to unassign, empty to remove); instructions go to the agent
#   kb rm KE-12                delete
#   kb api                     API reference
#
# Env: KB_URL (default http://127.0.0.1:7420), KB_PROJECT (project key), KB_ACTOR (your name).
set -euo pipefail

URL="${KB_URL:-http://127.0.0.1:7420}"
ACTOR="${KB_ACTOR:-${USER:-agent}}"
PROJECT="${KB_PROJECT:-}"

die() { echo "kb: $*" >&2; exit 1; }

req() {
  local method="$1" path="$2"; shift 2
  local out code
  out="$(curl -sS -X "$method" -H "X-Actor: $ACTOR" -w '\n%{http_code}' "$@" "$URL$path")" ||
    die "can't reach $URL (is KanbanEasy running?)"
  code="${out##*$'\n'}"
  out="${out%$'\n'*}"
  printf '%s' "$out"
  [[ "$out" == *$'\n' ]] || echo
  [[ "$code" -lt 400 ]] || exit 1
}

# turn k=v args into --data-urlencode flags
fields() {
  local a
  for a in "$@"; do
    [[ "$a" == *=* ]] || die "expected key=value, got '$a'"
    printf -- '--data-urlencode\0%s\0' "$a"
  done
}

with_fields() {
  local method="$1" path="$2"; shift 2
  local args=()
  if [[ $# -gt 0 ]]; then
    while IFS= read -r -d '' x; do args+=("$x"); done < <(fields "$@")
  fi
  req "$method" "$path" "${args[@]}"
}

project_q() { [[ -n "$PROJECT" ]] && printf 'project=%s&' "$PROJECT" || true; }

# the project to act on: KB_PROJECT, or the first one
project_key() {
  if [[ -n "$PROJECT" ]]; then
    echo "$PROJECT"
    return
  fi
  local key
  key="$(curl -sS "$URL/projects" | sed -n 's/.*"key": "\([^"]*\)".*/\1/p' | head -1)" ||
    die "can't reach $URL (is KanbanEasy running?)"
  [[ -n "$key" ]] || die "no projects"
  echo "$key"
}

cmd="${1:-board}"
shift || true
case "$cmd" in
  board)
    req GET "/projects/$(project_key)?format=md"
    ;;
  ls | list)
    q="$(project_q)"
    [[ $# -gt 0 ]] && q="${q}status=$1&"
    req GET "/issues?${q}format=md"
    ;;
  show | cat)
    [[ $# -ge 1 ]] || die "usage: kb show ID"
    req GET "/issues/$1?format=md"
    ;;
  add | new)
    [[ $# -ge 1 ]] || die "usage: kb add \"Title\" [key=value ...]"
    title="$1"; shift
    extra=()
    [[ -n "$PROJECT" ]] && extra+=("project=$PROJECT")
    with_fields POST /issues "title=$title" "${extra[@]+"${extra[@]}"}" "$@"
    ;;
  mv | move)
    [[ $# -ge 2 ]] || die "usage: kb mv ID status [position]"
    if [[ $# -ge 3 ]]; then
      with_fields POST "/issues/$1/move" "status=$2" "index=$3"
    else
      with_fields POST "/issues/$1/move" "status=$2"
    fi
    ;;
  set | edit)
    [[ $# -ge 2 ]] || die "usage: kb set ID key=value [...]"
    id="$1"; shift
    with_fields PATCH "/issues/$id" "$@"
    ;;
  note | comment)
    [[ $# -ge 2 ]] || die "usage: kb note ID \"text\""
    with_fields POST "/issues/$1/comments" "body=$2"
    ;;
  claim)
    who="${1:-$ACTOR}"
    extra=()
    [[ -n "$PROJECT" ]] && extra+=("project=$PROJECT")
    with_fields POST /claim "assignee=$who" "${extra[@]+"${extra[@]}"}"
    ;;
  mine | inbox)
    who="${1:-$ACTOR}"
    open=()
    while IFS= read -r line; do
      [[ "$line" == *"[Done]"* ]] || open+=("$line")
    done < <(req GET "/issues?$(project_q)assignee=$who&format=md")
    if [[ ${#open[@]} -gt 0 ]]; then printf '%s\n' "${open[@]}"; else echo "_nothing assigned to ${who}_"; fi
    ;;
  people)
    key="$(project_key)"
    if [[ $# -eq 0 ]]; then
      req GET "/projects/$key" | sed -n '/"default_assignee"/p; /"people"/,/}/p'
    else
      args=()
      for a in "$@"; do [[ "$a" == default=* ]] && args+=("default_assignee=${a#default=}") || args+=("$a"); done
      with_fields PATCH "/projects/$key" "${args[@]}" >/dev/null && echo "updated $key"
    fi
    ;;
  rule)
    [[ $# -ge 1 ]] || die "usage: kb rule COLUMN [assign=who] [instructions=\"...\"]"
    col="$1"; shift
    if [[ $# -eq 0 ]]; then
      # show the column (the PATCH route echoes it back, and an empty PATCH changes nothing)
      req PATCH "/projects/$(project_key)/columns/$col"
    else
      with_fields PATCH "/projects/$(project_key)/columns/$col" "$@"
    fi
    ;;
  rm | delete)
    [[ $# -ge 1 ]] || die "usage: kb rm ID"
    req DELETE "/issues/$1"
    ;;
  api | help-api)
    req GET /
    ;;
  -h | --help | help)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    die "unknown command '$cmd' (try kb help)"
    ;;
esac
